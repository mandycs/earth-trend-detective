# Copy to .env and fill in. Never commit .env.
# Earthdata Login user token (urs.earthdata.nasa.gov -> Generate Token). Used for GRACE (PO.DAAC) and GES DISC.
NASA_TOKEN=
# AppEEARS session token: POST https://appeears.earthdatacloud.nasa.gov/api/login with Earthdata user/password.
APPEEARS_TOKEN=
LLM_API_KEY=
