# Copy to .env.docker and fill in. Never commit the filled copy (.env.* is gitignored).
# Read by docker-compose.yml at runtime only; nothing here is baked into an image.

# LLM: one of the two. LLM_API_KEY (Anthropic direct) wins if both are set.
OPENROUTER_API_KEY=
LLM_API_KEY=
# Must match the active provider's id format (see backend/app/detective/README.md).
DETECTIVE_MODEL=

# NASA Earthdata / AppEEARS tokens: only needed to fetch data not already in the cache volume.
NASA_TOKEN=
APPEEARS_TOKEN=

# Optional run limits.
DETECTIVE_MAX_TOOL_CALLS=
DETECTIVE_MAX_SECONDS=
